{
  "name": "inline-chat-kit",
  "version": "0.1.0",
  "description": "A drop-in inline AI chat experience \u2014 morphing input, hover actions, text highlighting and reply threads.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/inline-chat-kit.js",
  "module": "./dist/inline-chat-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/inline-chat-kit.js"
    },
    "./styles.css": "./dist/inline-chat-kit.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite build --watch",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "motion": "^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.14.0",
    "motion": "^12.40.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.7"
  }
}
