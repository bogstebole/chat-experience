{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"]
  },
  "include": ["src"],
  // Tests are typechecked by the test run, not shipped. Without this they
  // emit declarations into dist and end up inside the published tarball.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/__tests__", "src/stories"]
}
