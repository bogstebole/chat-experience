{
  "name": "ai-chat-experience",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/playground",
    "build": "npm run build --workspace packages/inline-chat-kit && npm run build --workspace apps/playground",
    "build:kit": "npm run build --workspace packages/inline-chat-kit",
    "dev:kit": "npm run dev --workspace packages/inline-chat-kit",
    "lint": "eslint .",
    "pack:kit": "npm run build:kit && npm pack --workspace packages/inline-chat-kit --pack-destination packages/inline-chat-kit && mv packages/inline-chat-kit/inline-chat-kit-*.tgz packages/inline-chat-kit/inline-chat-kit.tgz",
    "test": "npm run test --workspace packages/inline-chat-kit",
    "test:watch": "npm run test:watch --workspace packages/inline-chat-kit",
    "showcase": "node tools/showcase/record.mjs",
    "showcase:questions": "node tools/showcase/questions.mjs",
    "shots": "node tools/shots/capture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript-eslint": "^8.58.2"
  }
}
