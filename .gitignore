# OS
.DS_Store

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Node
node_modules
*.log
npm-debug.log*

# Build output
dist
dist-ssr
*.local

# Tooling caches
.playwright-cli

# Kit build artefacts
packages/*/dist
*.tsbuildinfo

# Generated by `npm run shots` — regenerate rather than commit.
# Anchored: unanchored it matches at any depth, and on a case-insensitive
# filesystem that swallowed `tools/shots` along with it.
/Shots/

# Recordings. 35MB of them and growing, and git keeps every version forever.
# Anchored for the same reason as `/Shots/` above.
/Videos/

# Copies the filesystem makes beside a file being edited — "name 2.ts",
# "CONTRIBUTING 3.md". Two of them reached a commit before this line existed:
# one was a stale snapshot that disagreed with the file it shadowed, the other
# a byte-identical test that would have run twice.
* [0-9].*

# Secrets. Nothing here is needed to build the kit; a key in a commit is a key
# on GitHub forever, whatever happens to the file afterwards.
.env
.env.*
!.env.example
*.pem
*.key
.npmrc

# Claude Code's per-machine state: its worktrees and local settings.
.claude/worktrees/
.claude/settings.local.json

# Local-only notes: research, private roadmap items, hand-overs. Never pushed.
# A pre-push hook in .git/hooks refuses any push that touches these paths,
# because .gitignore cannot stop a file that was committed before it was listed.
/private/
docs/research/
